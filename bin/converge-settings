#!/usr/bin/env python3
"""Converge: the settings app for Phosh (GTK4/libadwaita).

Shows whether an external display is connected, switches to desktop mode
(Hyprland) and manages the settings in ~/.config/converge/converge.conf.
"""

import glob
import os
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

sys.path.insert(0, "/usr/lib/converge")
import converge_displays as displays_mod  # noqa: E402

APP_ID = "io.github.jeweet.Converge"
DOCK_SERVICE = "converge-dock.service"

CONF = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "converge", "converge.conf")

SCALES = [("auto", "Automatic"), ("1", "100%"), ("1.25", "125%"),
          ("1.5", "150%"), ("1.75", "175%"), ("2", "200%")]

# (key, title, subtitle, default)
OPTIONS = [
    ("PHONE_TOUCHPAD", "Phone screen as touchpad and keyboard",
     "The phone screen stays on in desktop mode as a touchpad and keyboard "
     "(Super+T shows or hides it)", False),
    ("AUDIO_TO_DISPLAY", "Audio through the external display",
     "Sound plays through the monitor or TV while docked", True),
    ("BLOCK_SUSPEND", "No suspend in desktop mode",
     "Locking and turning off the screen still happen when idle", True),
]


def read_conf():
    values = {}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    values[k.strip()] = v.strip().strip('"')
    except OSError:
        pass
    return values


def write_conf(key, value):
    """Change or add one line; everything else (and comments) stays."""
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    try:
        with open(CONF) as f:
            lines = f.readlines()
    except OSError:
        lines = []
    new = f"{key}={value}\n"
    for i, line in enumerate(lines):
        if line.strip().startswith(key + "="):
            lines[i] = new
            break
    else:
        lines.append(new)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        f.writelines(lines)
    os.replace(tmp, CONF)


def external_display():
    """(name, resolution) of a connected external display, or None."""
    for status in sorted(glob.glob("/sys/class/drm/card*-*/status")):
        connector = os.path.basename(os.path.dirname(status))  # card0-DP-1
        if "DSI" in connector or "eDP" in connector:
            continue
        try:
            with open(status) as f:
                if f.read().strip() != "connected":
                    continue
        except OSError:
            continue
        name = connector.split("-", 1)[1] if "-" in connector else connector
        resolution = ""
        try:
            with open(os.path.join(os.path.dirname(status), "modes")) as f:
                resolution = f.readline().strip()
        except OSError:
            pass
        return name, resolution
    return None


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Converge")
        self.set_default_size(360, 720)
        self.busy = False

        self.toasts = Adw.ToastOverlay()
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())

        # Shown when "converge doctor" finds problems
        self.banner = Adw.Banner(
            title="Converge is not set up completely",
            button_label="Details")
        self.banner.connect("button-clicked",
                            lambda *_a: self.check_row.set_expanded(True))
        toolbar.add_top_bar(self.banner)

        self.status = Adw.StatusPage()
        self.status.set_icon_name("video-display-symbolic")

        buttons = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        buttons.set_halign(Gtk.Align.CENTER)

        self.button = Gtk.Button(label="Switch to desktop mode")
        self.button.add_css_class("pill")
        self.button.add_css_class("suggested-action")
        self.button.connect("clicked", self.switch)
        buttons.append(self.button)

        self.spinner = Gtk.Spinner()
        self.spinner.set_visible(False)
        buttons.append(self.spinner)

        self.status.set_child(buttons)

        group = Adw.PreferencesGroup(
            title="Desktop mode",
            description="Applies the next time you switch")
        values = read_conf()
        for key, title, subtitle, default in OPTIONS:
            row = Adw.SwitchRow(title=title, subtitle=subtitle)
            row.set_active(values.get(key, "1" if default else "0") == "1")
            row.connect("notify::active", self.option_changed, key)
            group.add(row)
        # Displays: trusted displays and display profiles
        self.display_group = Adw.PreferencesGroup(
            title="Displays",
            description="Remembered per display. Scale and resolution apply "
                        "the next time you switch.")
        self.display_rows = []
        self.connected_ids = None

        # Installation check (converge doctor)
        self.check_group = Adw.PreferencesGroup(title="Installation")
        rerun = Gtk.Button(icon_name="view-refresh-symbolic",
                           tooltip_text="Check again")
        rerun.add_css_class("flat")
        rerun.connect("clicked", lambda *_a: self.check_setup())
        self.check_group.set_header_suffix(rerun)
        self.check_row = Adw.ExpanderRow(title="Checking…")
        self.check_group.add(self.check_row)
        self.check_children = []

        pages = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        for g in (group, self.display_group, self.check_group):
            pages.append(g)
        clamp = Adw.Clamp(maximum_size=520)
        clamp.set_margin_start(12)
        clamp.set_margin_end(12)
        clamp.set_margin_bottom(24)
        clamp.set_child(pages)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.append(self.status)
        content.append(clamp)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.set_child(content)
        toolbar.set_content(scroller)
        self.toasts.set_child(toolbar)
        self.set_content(self.toasts)

        self.refresh()
        # Follow plugging and unplugging live
        GLib.timeout_add_seconds(1, self.refresh)
        self.check_setup()

    # -- installation check --

    def check_setup(self):
        self.check_row.set_title("Checking…")
        self.check_row.set_subtitle("")
        try:
            proc = Gio.Subprocess.new(
                ["converge", "doctor", "--plain"],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error as error:
            self.check_row.set_title("Could not run converge doctor")
            self.check_row.set_subtitle(error.message)
            return
        proc.communicate_utf8_async(None, None, self._setup_checked)

    def _setup_checked(self, proc, result):
        try:
            _, out, _ = proc.communicate_utf8_finish(result)
        except GLib.Error:
            return
        for row in self.check_children:
            self.check_row.remove(row)
        self.check_children = []
        fails = warns = oks = 0
        for line in (out or "").splitlines():
            parts = line.split("\t", 2)
            if len(parts) != 3:
                continue
            state, section, message = parts
            if state == "ok":
                oks += 1
                continue
            if state == "fail":
                fails += 1
                icon = "dialog-error-symbolic"
            else:
                warns += 1
                icon = "dialog-warning-symbolic"
            row = Adw.ActionRow(title=message, subtitle=section,
                                use_markup=False, title_lines=0)
            image = Gtk.Image(icon_name=icon)
            if state == "fail":
                image.add_css_class("error")
            else:
                image.add_css_class("warning")
            row.add_prefix(image)
            self.check_row.add_row(row)
            self.check_children.append(row)
        if fails:
            self.check_row.set_title(f"{fails} problem(s), {warns} warning(s)")
            self.check_row.set_subtitle("Run “converge setup” in a terminal to fix most of them")
        elif warns:
            self.check_row.set_title(f"No problems, {warns} warning(s)")
            self.check_row.set_subtitle(f"{oks} checks passed")
        else:
            self.check_row.set_title("Everything is set up")
            self.check_row.set_subtitle(f"{oks} checks passed")
        self.check_row.set_enable_expansion(bool(self.check_children))
        self.banner.set_revealed(fails > 0)

    # -- displays --

    def rebuild_displays(self, connected):
        for row in self.display_rows:
            self.display_group.remove(row)
        self.display_rows = []
        remembered = displays_mod.load()
        shown = set()
        for d in connected:
            self._add_display_row(d["id"], d["name"], d["connector"],
                                  d["modes"], remembered)
            shown.add(d["id"])
        for ident, d in remembered.items():
            if ident not in shown:
                self._add_display_row(ident, d.get("name") or ident, None,
                                      [], remembered)
        if not self.display_rows:
            row = Adw.ActionRow(
                title="No displays yet",
                subtitle="Connect a display to set it up here")
            self.display_group.add(row)
            self.display_rows.append(row)

    def _add_display_row(self, ident, name, connector, modes, remembered):
        settings = displays_mod.settings(ident, remembered)
        row = Adw.ExpanderRow(title=name, use_markup=False)
        row.set_subtitle(f"Connected · {connector}" if connector else "Not connected")
        row.add_prefix(Gtk.Image(icon_name="video-display-symbolic"))
        if connector:
            row.set_expanded(True)

        trusted = Adw.SwitchRow(
            title="Switch without asking",
            subtitle="Go to desktop mode as soon as this display is "
                     "connected. Hyprland still starts locked.")
        trusted.set_active(settings["trusted"] == "1")
        trusted.connect("notify::active", lambda r, _p: self.save_display(
            ident, name, trusted="1" if r.get_active() else "0"))
        row.add_row(trusted)

        scale_values = [v for v, _ in SCALES]
        if settings["scale"] not in scale_values:
            SCALES_EXTRA = (settings["scale"], f"{settings['scale']} (custom)")
            scale_items = SCALES + [SCALES_EXTRA]
        else:
            scale_items = SCALES
        scale = Adw.ComboRow(title="Scale",
                             model=Gtk.StringList.new([t for _, t in scale_items]))
        scale.set_selected([v for v, _ in scale_items].index(settings["scale"]))
        scale.connect("notify::selected", lambda r, _p: self.save_display(
            ident, name, scale=scale_items[r.get_selected()][0]))
        row.add_row(scale)

        mode_items = [("preferred", "Preferred"), ("highres", "Highest")]
        mode_items += [(m, m) for m in modes]
        if settings["mode"] not in [v for v, _ in mode_items]:
            mode_items.append((settings["mode"], settings["mode"]))
        mode = Adw.ComboRow(title="Resolution",
                            model=Gtk.StringList.new([t for _, t in mode_items]))
        mode.set_selected([v for v, _ in mode_items].index(settings["mode"]))
        mode.connect("notify::selected", lambda r, _p: self.save_display(
            ident, name, mode=mode_items[r.get_selected()][0]))
        row.add_row(mode)

        if ident in remembered:
            forget = Adw.ActionRow(title="Forget this display")
            button = Gtk.Button(label="Forget", valign=Gtk.Align.CENTER)
            button.add_css_class("destructive-action")
            button.connect("clicked", lambda *_a: self.forget_display(ident))
            forget.add_suffix(button)
            row.add_row(forget)

        self.display_group.add(row)
        self.display_rows.append(row)

    def save_display(self, ident, name, **changes):
        try:
            remembered = displays_mod.load()
            entry = displays_mod.settings(ident, remembered)
            entry["name"] = name
            entry.update(changes)
            new = ident not in remembered
            remembered[ident] = entry
            displays_mod.save(remembered)
        except OSError as error:
            self.toasts.add_toast(Adw.Toast.new(f"Saving failed: {error}"))
            return
        if new:
            # Show the "Forget" button
            GLib.idle_add(self._rebuild_now)

    def forget_display(self, ident):
        remembered = displays_mod.load()
        remembered.pop(ident, None)
        try:
            displays_mod.save(remembered)
        except OSError as error:
            self.toasts.add_toast(Adw.Toast.new(f"Saving failed: {error}"))
        GLib.idle_add(self._rebuild_now)

    def _rebuild_now(self):
        connected = displays_mod.external_displays()
        self.connected_ids = [d["id"] for d in connected]
        self.rebuild_displays(connected)
        return False

    # -- status --

    def refresh(self):
        if self.busy:
            return True
        connected = displays_mod.external_displays()
        ids = [d["id"] for d in connected]
        if ids != self.connected_ids:
            self.connected_ids = ids
            self.rebuild_displays(connected)
        display = external_display()
        if display:
            name, resolution = display
            self.status.set_title("Display connected")
            description = name
            if resolution:
                description += f" · {resolution}"
            description += (
                "\n\nPhosh closes and Hyprland starts on the external display. "
                "Unlock there with your PIN."
            )
            self.status.set_description(description)
            self.button.set_sensitive(True)
        else:
            self.status.set_title("No display connected")
            self.status.set_description(
                "Connect a monitor over USB-C to switch to desktop mode."
            )
            self.button.set_sensitive(False)
        return True

    def option_changed(self, row, _pspec, key):
        try:
            write_conf(key, "1" if row.get_active() else "0")
        except OSError as error:
            self.toasts.add_toast(Adw.Toast.new(f"Saving failed: {error}"))

    def switch(self, _button):
        self.busy = True
        self.button.set_sensitive(False)
        self.button.set_label("Switching…")
        self.spinner.set_visible(True)
        self.spinner.start()
        try:
            proc = Gio.Subprocess.new(
                ["systemctl", "start", "--no-block", DOCK_SERVICE],
                Gio.SubprocessFlags.STDERR_PIPE,
            )
        except GLib.Error as error:
            self.failed(error.message)
            return
        proc.communicate_utf8_async(None, None, self.started)

    def started(self, proc, result):
        try:
            _, _, err = proc.communicate_utf8_finish(result)
        except GLib.Error as error:
            self.failed(error.message)
            return
        if not proc.get_successful():
            self.failed((err or "").strip() or "unknown error")
        # On success Phosh closes by itself; nothing left to do

    def failed(self, message):
        self.busy = False
        self.spinner.stop()
        self.spinner.set_visible(False)
        self.button.set_label("Switch to desktop mode")
        self.refresh()
        self.toasts.add_toast(Adw.Toast.new(f"Switching failed: {message}"))


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        window = self.get_active_window() or Window(self)
        window.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
