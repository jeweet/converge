#!/bin/sh
# Start Hyprland from greetd (desktop mode), logging to the journal.
#
# Safety net: if Hyprland stops within CRASH_SECONDS after starting, that
# counts as a crash and the phone goes back to Phosh (with a notification).
# Closing Hyprland yourself (Super+Shift+E) also goes back to Phosh.

. /usr/lib/converge/common.sh
converge_load_conf

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland

# See HYPRLAND_NO_ATOMIC in /etc/converge.conf
if [ "$HYPRLAND_NO_ATOMIC" = 1 ]; then
    export AQ_NO_MODIFIERS=1
    export AQ_NO_ATOMIC=1
fi

log() { converge_log converge-hyprland "converge-hyprland-session: $*"; }

# Stop the session target afterwards; otherwise graphical-session.target
# stays active and Phosh (gnome-session) cannot start properly.
cleanup() {
    systemctl --user stop converge-hyprland-session.target 2>/dev/null
}
trap 'cleanup; exit 0' INT TERM HUP

# Settings that must be known before Hyprland starts: changing outputs while
# Hyprland runs can turn the external display black. The packaged
# hyprland.conf sources this file.
internal=$(converge_internal_display)
state="${XDG_STATE_HOME:-$HOME/.local/state}/converge"
mkdir -p "$state"
{
    echo "# Generated by converge at the start of desktop mode; do not edit."
    echo "# Change PHONE_TOUCHPAD / INTERNAL_DISPLAY in ~/.config/converge/converge.conf"
    if [ "$PHONE_TOUCHPAD" = 1 ]; then
        echo "monitor = $internal, preferred, auto-down, auto"
    else
        echo "monitor = $internal, disable"
    fi
    # Touchscreens belong to the phone screen (used by the touchpad panel)
    converge_touchscreens | while IFS= read -r name; do
        [ -n "$name" ] || continue
        hname=$(printf '%s' "$name" | tr 'A-Z ' 'a-z-')
        printf 'device {\n    name = %s\n    output = %s\n}\n' "$hname" "$internal"
    done
} >"$state/hyprland-generated.conf"
if [ "$PHONE_TOUCHPAD" = 1 ]; then
    log "phone screen $internal on (touchpad panel)"
fi

start=$(date +%s)
log "starting Hyprland"

# Recent Hyprland versions want to be started through start-hyprland
if command -v start-hyprland >/dev/null 2>&1; then
    systemd-cat --identifier=hyprland start-hyprland &
else
    systemd-cat --identifier=hyprland Hyprland &
fi
wait $!
code=$?
duration=$(( $(date +%s) - start ))
cleanup

# Deliberate switch by converge-switch (cable unplugged etc.): nothing to do
if [ -f "$CONVERGE_RUN/switching" ]; then
    log "Hyprland stopped by a switch (after ${duration}s)"
    exit 0
fi

if [ "$duration" -lt "$CRASH_SECONDS" ]; then
    log "SAFETY NET: Hyprland stopped after ${duration}s (code $code), back to the phone"
    systemctl start --no-block 'converge-action@fallback.service'
else
    log "Hyprland closed after ${duration}s (code $code), back to the phone"
    systemctl start --no-block 'converge-action@phone.service'
fi
# Give the switch time to end this session cleanly
sleep 15
