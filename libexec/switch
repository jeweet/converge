#!/bin/sh
# converge switch: move greetd between Phosh (phone) and Hyprland (docked).
# Runs as root, except "status" (works as a normal user, with less detail).
#
#   switch auto      check for an external display and switch if needed;
#                    asks for confirmation in Phosh first
#   switch dock      force Hyprland (no question)
#   switch manual    go to Hyprland if a display is connected, no question
#                    (the "Switch to desktop mode" button in the app)
#   switch undock    force Phosh
#   switch phone     Hyprland was closed: back to the phone
#   switch fallback  Hyprland crashed right after starting: back to the
#                    phone and remember it for the status
#   switch reset     everything back to the normal greeter login
#   switch status    overview of what is active
#
# Settings: /etc/converge.conf. All state lives in /run, so a reboot
# always brings back the normal greeter.

. /usr/lib/converge/common.sh
converge_load_system_conf

GREETD_CONFIG=$(converge_greetd_config)
DROPIN_DIR=/run/systemd/system/greetd.service.d
DROPIN="$DROPIN_DIR/zz-converge.conf"
DOCKED_CONFIG="$CONVERGE_RUN/greetd-docked.toml"
UNDOCKED_CONFIG="$CONVERGE_RUN/greetd-undocked.toml"
LOCK="$CONVERGE_RUN/switch.lock"
DECLINED="$CONVERGE_RUN/declined"
SWITCHING="$CONVERGE_RUN/switching"
CRASH="$CONVERGE_RUN/crash"
GOVERNORS_SAVED="$CONVERGE_RUN/governors"

log() { echo "converge-switch: $*"; }

is_docked() { [ -f "$DROPIN" ] && grep -q "$DOCKED_CONFIG" "$DROPIN"; }

user() { converge_user; }

# ---------- greetd configs ----------------------------------------------------

# Raw value of a key in a section of the normal greetd config
greetd_value() {
    # $1 = section, $2 = key
    awk -v sec="$1" -v key="$2" '
        /^[ \t]*\[/ { s = $0; gsub(/[ \t\[\]]/, "", s); cur = s; next }
        cur == sec {
            line = $0
            sub(/^[ \t]*/, "", line)
            k = line; sub(/[ \t]*=.*/, "", k)
            if (k == key) { v = line; sub(/^[^=]*=[ \t]*/, "", v); print v; exit }
        }' "$GREETD_CONFIG" 2>/dev/null
}

# Write a greetd config that logs the user in directly with $2.
# The greeter of the normal config stays the default session, so logging
# out still ends at the normal greeter.
write_greetd_config() {
    # $1 = file, $2 = session command, $3 = runfile
    u=$(user)
    vt=$(greetd_value terminal vt)
    greeter=$(greetd_value default_session command)
    greeter_user=$(greetd_value default_session user)
    [ -n "$vt" ] || vt=7
    if [ -z "$greeter" ]; then
        log "WARNING: no [default_session] in $GREETD_CONFIG"
        if [ -x /usr/libexec/phrog-greetd-session ]; then
            greeter='"/usr/libexec/phrog-greetd-session"'
        else
            greeter='"agreety --cmd /bin/sh"'
        fi
    fi
    [ -n "$greeter_user" ] || greeter_user='"greetd"'
    mkdir -p "$CONVERGE_RUN"
    cat >"$1" <<EOF
# Generated by converge-switch; removed on reboot
[general]
# greetd starts initial_session only once per runfile; converge-switch
# removes it before every switch
runfile = "$3"

[terminal]
vt = $vt

[default_session]
command = $greeter
user = $greeter_user

[initial_session]
command = "$2"
user = "$u"
EOF
}

write_greetd_configs() {
    write_greetd_config "$DOCKED_CONFIG" \
        "$CONVERGE_LIBEXEC/hyprland-session" \
        "$CONVERGE_RUN/greetd-docked.run"
    write_greetd_config "$UNDOCKED_CONFIG" \
        "systemd-cat --identifier=converge-phosh $CONVERGE_LIBEXEC/phosh-session" \
        "$CONVERGE_RUN/greetd-undocked.run"
}

# ---------- Performance -------------------------------------------------------

# CPU governor "performance" while docked. The previous governors are saved
# in /run and restored when undocking.
performance_on() {
    [ "$PERFORMANCE" = 1 ] || return 0
    if [ ! -f "$GOVERNORS_SAVED" ]; then
        for p in /sys/devices/system/cpu/cpufreq/policy*; do
            [ -w "$p/scaling_governor" ] || continue
            echo "$p $(cat "$p/scaling_governor")" >>"$GOVERNORS_SAVED"
        done
    fi
    for p in /sys/devices/system/cpu/cpufreq/policy*; do
        grep -qw performance "$p/scaling_available_governors" 2>/dev/null || continue
        echo performance >"$p/scaling_governor" 2>/dev/null
    done
    log "performance: CPU governor set to performance"
}

performance_off() {
    [ -f "$GOVERNORS_SAVED" ] || return 0
    while read -r p g; do
        echo "$g" >"$p/scaling_governor" 2>/dev/null
    done <"$GOVERNORS_SAVED"
    rm -f "$GOVERNORS_SAVED"
    log "performance: CPU governors restored"
}

# ---------- Switching sessions ------------------------------------------------

# Stop the user's graphical session completely. Recent gnome-session runs
# Phosh as systemd user services; those keep running after greetd restarts
# and block the next session ("A graphical session is already running").
stop_session() {
    u=$(user)
    [ -n "$u" ] || return 0
    log "stopping the graphical session of $u"
    systemctl --user -M "$u@" stop converge-hyprland-session.target graphical-session.target 2>/dev/null
    i=0
    while [ $i -lt 20 ]; do
        systemctl --user -M "$u@" is-active --quiet graphical-session.target 2>/dev/null || break
        sleep 0.5
        i=$((i + 1))
    done
}

# Restart greetd with the given config
greetd_with() {
    config=$1
    # Tell the session scripts this is a deliberate switch (not a crash)
    mkdir -p "$CONVERGE_RUN"
    touch "$SWITCHING"
    write_greetd_configs
    systemctl stop greetd
    stop_session
    runfile=$(sed -n 's/^runfile *= *"\(.*\)"/\1/p' "$config")
    [ -n "$runfile" ] && rm -f "$runfile"
    mkdir -p "$DROPIN_DIR"
    cat >"$DROPIN" <<EOF
# Temporary (removed on reboot) - created by converge-switch
[Service]
ExecStart=
ExecStart=greetd -c $config
EOF
    systemctl daemon-reload
    systemctl start greetd
    rm -f "$SWITCHING"
}

# Back to the normal greetd config
greetd_default() {
    mkdir -p "$CONVERGE_RUN"
    touch "$SWITCHING"
    systemctl stop greetd
    stop_session
    rm -f "$DROPIN"
    systemctl daemon-reload
    systemctl start greetd
    rm -f "$SWITCHING"
}

# ---------- Notifications -----------------------------------------------------

# Ask in Phosh whether to switch to desktop mode.
# 0 = confirmed, 1 = not confirmed / not asked, 2 = cannot ask
ask() {
    u=$(user)
    [ -n "$u" ] || return 2
    if ! pgrep -u "$u" -x phosh >/dev/null 2>&1; then
        log "Phosh is not running (e.g. at the greeter): not asking"
        return 1
    fi
    if ! command -v notify-send >/dev/null 2>&1; then
        log "notify-send is missing (apk add libnotify): cannot ask"
        return 2
    fi
    log "asking for confirmation in Phosh (up to $PROMPT_TIMEOUT s)"
    answer=$(systemd-run --user -M "$u@" --wait --pipe --quiet --collect \
        timeout "$PROMPT_TIMEOUT" notify-send \
            -a Converge -i video-display \
            -h "string:desktop-entry:$CONVERGE_APP_ID" \
            -u critical \
            -A dock="Desktop mode" -A phone="Stay on phone" -w \
            "Display connected" "Switch to desktop mode?" \
        </dev/null 2>/dev/null)
    log "answer: '${answer:-none}'"
    [ "$answer" = dock ]
}

# Short notification in the user's session (does not wait)
notify() {
    u=$(user)
    [ -n "$u" ] || return 0
    command -v notify-send >/dev/null 2>&1 || return 0
    systemd-run --user -M "$u@" --quiet --collect \
        notify-send -a Converge -i video-display \
            -h "string:desktop-entry:$CONVERGE_APP_ID" \
            "$1" "$2" >/dev/null 2>&1
}

# ---------- Actions -----------------------------------------------------------

dock() {
    is_docked && { log "already docked"; return 0; }
    [ -n "$(user)" ] || { log "no user found; set CONVERGE_USER in $CONVERGE_SYSCONF"; return 1; }
    log "external display: switching to Hyprland"
    rm -f "$CRASH"
    performance_on
    greetd_with "$DOCKED_CONFIG"
}

undock() {
    is_docked || { log "already undocked"; return 0; }
    performance_off
    log "switching to Phosh (locked)"
    greetd_with "$UNDOCKED_CONFIG"
}

# Hyprland was closed normally (Super+Shift+E): back to the phone, and do
# not ask again while the display stays connected
phone() {
    log "Hyprland closed: back to the phone"
    mkdir -p "$CONVERGE_RUN"
    touch "$DECLINED"
    undock
}

# Hyprland stopped right after starting: back to the phone, remember it
fallback() {
    log "SAFETY NET: Hyprland stopped right after starting, back to the phone"
    mkdir -p "$CONVERGE_RUN"
    date '+%Y-%m-%d %H:%M:%S' >"$CRASH"
    touch "$DECLINED"
    undock
}

auto() {
    # Several hotplug events in a row: keep adjusting until stable
    n=0
    while [ $n -lt 3 ]; do
        if converge_external_connected; then
            is_docked && return 0
            # Already said "no" since plugging in: do not ask again
            [ -f "$DECLINED" ] && return 0
            ask
            case $? in
                0)
                    converge_external_connected || { log "display gone again"; return 0; }
                    dock ;;
                2)
                    # Cannot ask: switch right away
                    dock ;;
                *)
                    log "not confirmed: staying on the phone"
                    if pgrep -u "$(user)" -x phosh >/dev/null 2>&1; then
                        mkdir -p "$CONVERGE_RUN"
                        touch "$DECLINED"
                    fi
                    return 0 ;;
            esac
        else
            rm -f "$DECLINED"
            is_docked || return 0
            undock
        fi
        sleep 3
        n=$((n + 1))
    done
}

# From the Converge app: only with a display connected, no question
manual() {
    if converge_external_connected; then
        rm -f "$DECLINED"
        dock
    else
        log "manual: no external display connected, nothing done"
        notify "No display connected" "Connect a monitor first to switch to desktop mode."
    fi
}

reset() {
    log "back to the default greeter"
    rm -f "$DECLINED"
    performance_off
    greetd_default
}

# An active drop-in from the old manual install points to configs in
# /etc/greetd that "converge setup" removes. Point it to the new ones,
# without restarting greetd (the running session stays).
migrate_runtime() {
    [ -f "$DROPIN" ] || return 0
    if grep -q '/etc/greetd/converge-docked.toml' "$DROPIN"; then
        new=$DOCKED_CONFIG
    elif grep -q '/etc/greetd/converge-undocked.toml' "$DROPIN"; then
        new=$UNDOCKED_CONFIG
    else
        return 0
    fi
    write_greetd_configs
    sed -i "s|^ExecStart=greetd -c .*|ExecStart=greetd -c $new|" "$DROPIN"
    systemctl daemon-reload
    log "migrated the active greetd drop-in to $new"
}

# ---------- Status ------------------------------------------------------------

yes_no() { if "$@"; then echo yes; else echo no; fi; }

status() {
    u=$(user)
    echo "== Converge $CONVERGE_VERSION =="
    echo
    printf 'Mode:               '
    if is_docked; then echo "desktop (Hyprland)"
    elif [ -f "$DROPIN" ]; then echo "phone (Phosh, automatic login)"
    else echo "default (greeter)"; fi
    printf 'External display:   '
    found=""
    for s in /sys/class/drm/card*-*/status; do
        case "$s" in *DSI*|*eDP*) continue ;; esac
        if [ "$(cat "$s" 2>/dev/null)" = connected ]; then
            d=$(dirname "$s"); n=$(basename "$d"); n=${n#card*-}
            printf '%s (%s)\n' "$n" "$(head -n1 "$d/modes" 2>/dev/null)"
            found=1
        fi
    done
    [ -n "$found" ] || echo none
    echo "User:               ${u:-(none found)}"
    echo "Do not ask again:   $(yes_no test -f "$DECLINED")  (until unplugged)"
    echo "Switch in progress: $(yes_no test -f "$SWITCHING")"
    if [ -f "$CRASH" ]; then
        echo "Safety net:         Hyprland crashed at $(cat "$CRASH")"
    else
        echo "Safety net:         no crash"
    fi
    echo
    echo "CPU governors:      $(cat /sys/devices/system/cpu/cpufreq/policy*/scaling_governor 2>/dev/null | sort | uniq -c | awk '{printf "%sx %s  ", $1, $2}')"
    echo "Performance mode:   $(if [ -f "$GOVERNORS_SAVED" ]; then echo on; else echo off; fi)  (PERFORMANCE=$PERFORMANCE)"
    echo "greetd config:      $GREETD_CONFIG"
    echo "greetd:             $(systemctl is-active greetd 2>/dev/null)  ($(sed -n 's/^ExecStart=greetd -c //p' "$DROPIN" 2>/dev/null))"
    echo
    if [ -n "$u" ]; then
        echo "Sessions of $u:"
        for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$u" '$3 == u {print $1}'); do
            loginctl show-session "$s" -p Id -p Service -p Type -p Class -p State --value 2>/dev/null | paste -sd ' ' | sed 's/^/  /'
        done
        if [ "$(id -u)" = 0 ]; then
            uctl="systemctl --user -M $u@"
        elif [ "$(id -un)" = "$u" ]; then
            uctl="systemctl --user"
        else
            uctl=""
        fi
        if [ -n "$uctl" ]; then
            echo "Graphical session:  $($uctl is-active graphical-session.target 2>/dev/null)"
            echo "Hyprland session:   $($uctl is-active converge-hyprland-session.target 2>/dev/null)"
            echo "Autostart apps:     $($uctl is-active xdg-desktop-autostart.target 2>/dev/null)"
        fi
    fi
    echo
    echo "Recent switches:"
    journalctl -u converge-switch -u converge-dock -u 'converge-action@*' -b -n 8 --no-pager -o short 2>/dev/null \
        | grep 'converge-switch:' | sed 's/^/  /' || echo "  (no access to the journal; try with sudo)"
    echo
    echo "Recent desktop session messages:"
    journalctl -b -t converge-hyprland -n 5 --no-pager -o short 2>/dev/null | sed 's/^/  /'
}

# ---------- Main --------------------------------------------------------------

if [ "${1:-auto}" = status ]; then
    status
    exit 0
fi

if [ "$(id -u)" != 0 ]; then
    echo "converge-switch: must run as root (use: converge dock|phone, or sudo)" >&2
    exit 1
fi

# Never two switches at the same time
mkdir -p "$CONVERGE_RUN"
chmod 755 "$CONVERGE_RUN"
exec 9>"$LOCK"
flock 9

case "${1:-auto}" in
    auto)     auto ;;
    dock)     dock ;;
    manual)   manual ;;
    undock)   undock ;;
    phone)    phone ;;
    fallback) fallback ;;
    reset)    reset ;;
    migrate-runtime) migrate_runtime ;;
    *) echo "usage: $0 [auto|dock|manual|undock|phone|fallback|reset|status]" >&2; exit 2 ;;
esac
