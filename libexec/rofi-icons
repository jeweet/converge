#!/usr/bin/env python3
"""converge rofi-icons: pre-render app icons as small PNGs for rofi.

Rofi has no daemon mode: it loads every icon again on each start, and
rendering SVG icons is slow on a phone. This script looks up the icon of
every app (like GTK does, in the Adwaita theme) and saves it once as a
48px PNG in an icon theme called "Converge" (inheriting Adwaita). Rofi with
icon-theme "Converge" then only has to load small PNGs.

Only new or changed icons are rendered again, so after the first run this
is quick. "desktop start" runs it in the background on every dock.

Rebuild everything:  rm -rf ~/.local/share/icons/Converge
"""

import configparser
import os
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, Gtk  # noqa: E402

SIZE = 48
SOURCE_THEME = "Adwaita"
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
THEME = DATA_HOME / "icons" / "Converge"
TARGET = THEME / f"{SIZE}x{SIZE}" / "apps"

INDEX = f"""[Icon Theme]
Name=Converge
Comment=PNG copies of app icons for rofi (converge rofi-icons)
Inherits={SOURCE_THEME},hicolor
Directories={SIZE}x{SIZE}/apps

[{SIZE}x{SIZE}/apps]
Size={SIZE}
Context=Applications
Type=Fixed
"""


def log(text):
    print(f"converge-rofi-icons: {text}", file=sys.stderr)


def application_dirs():
    """All applications directories in XDG order (user dir first)."""
    dirs = [DATA_HOME] + [
        Path(d) for d in os.environ.get(
            "XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":") if d
    ]
    for extra in ("/var/lib/flatpak/exports/share",
                  str(Path.home() / ".local/share/flatpak/exports/share")):
        if Path(extra) not in dirs:
            dirs.append(Path(extra))
    return [d / "applications" for d in dirs if (d / "applications").is_dir()]


def icon_names():
    """Icon names from all .desktop files (absolute paths are skipped)."""
    names = set()
    seen = set()
    for appdir in application_dirs():
        for f in appdir.rglob("*.desktop"):
            app_id = f.relative_to(appdir).as_posix().replace("/", "-")
            if app_id in seen:
                continue
            seen.add(app_id)
            cp = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                cp.read(f, encoding="utf-8")
                icon = cp.get("Desktop Entry", "Icon", fallback="").strip()
            except (configparser.Error, UnicodeDecodeError):
                continue
            if icon and "/" not in icon:
                names.add(icon)
    return names


def main():
    Gtk.init()
    theme = Gtk.IconTheme()
    theme.set_theme_name(SOURCE_THEME)

    TARGET.mkdir(parents=True, exist_ok=True)
    index = THEME / "index.theme"
    if not index.exists() or index.read_text() != INDEX:
        index.write_text(INDEX)

    made = 0
    for name in sorted(icon_names()):
        if not theme.has_icon(name):
            continue
        paintable = theme.lookup_icon(name, None, SIZE, 1,
                                      Gtk.TextDirection.NONE, 0)
        gfile = paintable.get_file() if paintable else None
        path = gfile.get_path() if gfile else None
        if not path or not os.path.isfile(path):
            continue

        out = TARGET / f"{name}.png"
        if out.exists() and out.stat().st_mtime >= os.stat(path).st_mtime:
            continue
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, SIZE, SIZE, True)
            tmp = out.with_suffix(".tmp")
            pb.savev(str(tmp), "png", [], [])
            tmp.replace(out)
            made += 1
        except Exception as error:  # broken or unknown format: skip
            log(f"{name} ({path}): {error}")

    os.utime(THEME, None)
    log(f"{made} icon(s) updated in {TARGET}")


if __name__ == "__main__":
    main()
