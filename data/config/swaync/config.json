{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "control-center-width": 420,
  "control-center-height": 700,
  "fit-to-screen": true,
  "notification-window-width": 420,
  "notification-icon-size": 48,
  "notification-body-image-height": 120,
  "notification-body-image-width": 200,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 200,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "menubar",
    "volume",
    "buttons-grid",
    "mpris",
    "title",
    "notifications"
  ],
  "widget-config": {
    "menubar": {
      "buttons#actions": {
        "position": "right",
        "actions": [
          {
            "label": "",
            "command": "sh -c \"swaync-client -cp; sleep 0.4; /usr/libexec/converge/desktop screenshot area\""
          },
          {
            "label": "",
            "command": "sh -c \"swaync-client -cp; gnome-control-center\""
          },
          {
            "label": "",
            "command": "sh -c \"swaync-client -cp; /usr/libexec/converge/desktop lock\""
          }
        ]
      },
      "menu#power": {
        "label": "",
        "position": "right",
        "actions": [
          {
            "label": "Leave Desktop Mode",
            "command": "sh -c \"swaync-client -cp; converge phone\""
          },
          {
            "label": "Restart…",
            "command": "systemctl reboot"
          },
          {
            "label": "Power Off…",
            "command": "systemctl poweroff"
          }
        ]
      }
    },
    "volume": {
      "label": "",
      "show-per-app": false
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "   Wi-Fi",
          "type": "toggle",
          "command": "sh -c \"/usr/libexec/converge/qs set wifi\"",
          "update-command": "sh -c \"/usr/libexec/converge/qs status wifi\""
        },
        {
          "label": "   Bluetooth",
          "type": "toggle",
          "command": "sh -c \"/usr/libexec/converge/qs set bluetooth\"",
          "update-command": "sh -c \"/usr/libexec/converge/qs status bluetooth\""
        },
        {
          "label": "   Mobile Data",
          "type": "toggle",
          "command": "sh -c \"/usr/libexec/converge/qs set data\"",
          "update-command": "sh -c \"/usr/libexec/converge/qs status data\""
        },
        {
          "label": "   VPN",
          "type": "toggle",
          "command": "sh -c \"/usr/libexec/converge/qs set vpn\"",
          "update-command": "sh -c \"/usr/libexec/converge/qs status vpn\""
        },
        {
          "label": "   Dark Style",
          "type": "toggle",
          "command": "sh -c \"/usr/libexec/converge/qs set dark\"",
          "update-command": "sh -c \"/usr/libexec/converge/qs status dark\""
        },
        {
          "label": "   Airplane Mode",
          "type": "toggle",
          "command": "sh -c \"/usr/libexec/converge/qs set airplane\"",
          "update-command": "sh -c \"/usr/libexec/converge/qs status airplane\""
        },
        {
          "label": "   Do Not Disturb",
          "type": "toggle",
          "command": "sh -c \"swaync-client -d -sw\"",
          "update-command": "sh -c \"swaync-client -D\""
        }
      ]
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "mpris": {
      "image-size": 48,
      "image-radius": 10
    }
  }
}
